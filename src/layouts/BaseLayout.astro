---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { seo } from "../data/content";
import { buildWhatsAppLink } from "../utils/whatsapp";

const baseSeo = seo ?? {};
const {
  title = baseSeo.title ?? "Clinica Dental Mirador | Odontologia e implantologia en Ovalle",
  description =
    baseSeo.description ??
    "Atencion odontologica integral en Ovalle. Implantologia, rehabilitacion oral y estetica con enfoque en resultados duraderos y trato cercano.",
  keywords =
    baseSeo.keywords ??
    "Clinica Dental Mirador, Alejandro Bacic, dentista en Ovalle, implantologia en Ovalle, implantes dentales, rehabilitacion oral, odontologia estetica, ortodoncia, endodoncia, blanqueamiento dental, odontopediatria, salud bucal en Ovalle",
  canonical = baseSeo.canonical,
  ogImage = baseSeo.ogImage ?? "/fav.png",
} = Astro.props;

const siteName = baseSeo.siteName ?? "Clinica Dental Mirador";
const phone = baseSeo.phone ?? "+56927151566";
const email = baseSeo.email ?? "a.bacic.v@gmail.com";
const sameAs = baseSeo.sameAs ?? [
  "https://www.instagram.com/clinicadental.sb/",
  "https://web.facebook.com/people/Clinica-Dental-SB/61553382780456/?is_tour_dismissed=true",
];
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : canonical;
const ogImageUrl = Astro.site ? new URL(ogImage, Astro.site).toString() : ogImage;
const whatsappLink = buildWhatsAppLink(phone, "Hola, quiero agendar una evaluacion.");
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Dentist",
  name: siteName,
  image: ogImageUrl,
  url: canonicalUrl,
  telephone: phone,
  email,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Avda. Manuel Penafiel #1480, Of. 315-316 B",
    addressLocality: "Ovalle",
    addressRegion: "Coquimbo",
    addressCountry: "CL",
  },
  areaServed: "Ovalle, Coquimbo, Chile",
  priceRange: "$$",
  openingHours: ["Mo-Fr 09:00-13:00", "Mo-Fr 15:00-20:00", "Sa 09:00-13:00"],
  sameAs,
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={siteName} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#c8ab88" />
    <meta name="color-scheme" content="light" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" type="image/png" sizes="512x512" href="/fav.png" />
    <link rel="apple-touch-icon" href="/fav.png" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="es_CL" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href="/fav.png" />
    <title>{title}</title>
    <script type="application/ld+json">
      {JSON.stringify(structuredData)}
    </script>
  </head>
  <body>
    <a
      class="fixed bottom-4 right-4 z-50 inline-flex items-center gap-2 rounded-full bg-[#25D366] px-4 py-3 text-sm font-semibold text-[#0b0f0c] shadow-[0_12px_30px_rgba(37,211,102,0.4)] transition hover:bg-[#38e377] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1b1916] sm:px-3 sm:py-3 animation-pulse"
      href={whatsappLink}
      target="_blank"
      rel="noreferrer noopener"
      aria-label="Agendar por WhatsApp"
    >
      <img src="/svg/whatsappButton.svg" alt="" class="h-5 w-5" aria-hidden="true" />
      <span class="sm:hidden">Agendar</span>
    </a>
    <Header />
    <slot />
    <Footer />
    <script>
      (() => {
        const revealElements = Array.from(document.querySelectorAll("[data-reveal]"));
        if (revealElements.length === 0) return;

        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        if (reduceMotion.matches) {
          revealElements.forEach((el) => el.classList.add("reveal-visible"));
          return;
        }

        document.querySelectorAll("[data-reveal-group]").forEach((group) => {
          const stagger = parseFloat(group.dataset.revealStagger || "0.1");
          const children = Array.from(group.querySelectorAll("[data-reveal]"));
          children.forEach((child, index) => {
            if (!child.dataset.revealDelay) {
              child.dataset.revealDelay = (index * stagger).toFixed(3);
            }
          });
        });

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const el = entry.target;
              const once = el.dataset.revealOnce !== "false";
              const toggle = el.dataset.revealToggle === "true";
              if (entry.isIntersecting) {
                const delay = parseFloat(el.dataset.revealDelay || "0");
                if (delay) {
                  el.style.setProperty("--reveal-delay", `${delay}s`);
                }
                el.classList.add("reveal-visible");
                if (once) observer.unobserve(el);
              } else if (toggle) {
                el.classList.remove("reveal-visible");
              }
            });
          },
          { threshold: 0.18, rootMargin: "0px 0px -5% 0px" }
        );

        revealElements.forEach((el) => observer.observe(el));
      })();
    </script>
  </body>
</html>




