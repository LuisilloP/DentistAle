---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AliadoDigitalBanner from "../components/AliadoDigitalBanner.astro";
import { seo } from "../data/content";
import { buildWhatsAppLink } from "../utils/whatsapp";

const baseSeo = seo ?? {};
const {
  title = baseSeo.title ?? "Clínica Dental Mirador | Odontología e implantología en Ovalle",
  description =
    baseSeo.description ??
    "Atención odontológica integral en Ovalle. Implantología, rehabilitación oral y estética con enfoque en resultados duraderos y trato cercano.",
  keywords =
    baseSeo.keywords ??
    "Clínica Dental Mirador, Alejandro Bacic, dentista en Ovalle, implantología en Ovalle, implantes dentales, rehabilitación oral, odontología estética, ortodoncia, endodoncia, blanqueamiento dental, odontopediatría, salud bucal en Ovalle",
  canonical = baseSeo.canonical,
  ogImage = baseSeo.ogImage ?? "/fav.png",
} = Astro.props;

const siteName = baseSeo.siteName ?? "Clínica Dental Mirador";
const phone = baseSeo.phone ?? "+56927151566";
const email = baseSeo.email ?? "a.bacic.v@gmail.com";
const sameAs = baseSeo.sameAs ?? [
  "https://www.instagram.com/clinicadental.sb/",
  "https://web.facebook.com/people/Clinica-Dental-SB/61553382780456/?is_tour_dismissed=true",
];
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : canonical;
const ogImageUrl = Astro.site ? new URL(ogImage, Astro.site).toString() : ogImage;
const whatsappLink = buildWhatsAppLink(phone, "Hola, quiero agendar una evaluación.");
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Dentist",
  name: siteName,
  image: ogImageUrl,
  url: canonicalUrl,
  telephone: phone,
  email,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Avda. Manuel Penafiel #1480, Of. 315-316 B",
    addressLocality: "Ovalle",
    addressRegion: "Coquimbo",
    addressCountry: "CL",
  },
  contactPoint: {
    "@type": "ContactPoint",
    telephone: phone,
    contactType: "customer service",
    areaServed: "CL",
    availableLanguage: ["es"],
  },
  areaServed: "Ovalle, Coquimbo, Chile",
  priceRange: "$$",
  openingHours: ["Mo-Fr 09:00-13:00", "Mo-Fr 15:00-20:00", "Sa 09:00-13:00"],
  sameAs,
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={siteName} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#c8ab88" />
    <meta name="color-scheme" content="light" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" type="image/png" sizes="512x512" href="/fav.png" />
    <link rel="apple-touch-icon" href="/fav.png" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="es_CL" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href="/fav.png" />
    <title>{title}</title>
    <script type="application/ld+json">
      {JSON.stringify(structuredData)}
    </script>
  </head>
  <body>
    <a
      class="fixed bottom-5 right-5 z-50 inline-flex h-14 w-14 md:h-16 md:w-16 items-center justify-center rounded-full bg-[#25D366] text-[#0b0f0c] shadow-[0_15px_40px_rgba(37,211,102,0.38)] ring-2 ring-[#0b0f0c]/5 transition-transform duration-200 hover:scale-[1.05] hover:bg-[#38e377] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#1b1916]"
      href={whatsappLink}
      target="_blank"
      rel="noreferrer noopener"
      aria-label="WhatsApp"
    >
      <img src="/svg/whatsappButton.svg" alt="" class="h-7 w-7 md:h-9 md:w-9" aria-hidden="true" />
    </a>
    <Header />
    <slot />
    <Footer />
    <AliadoDigitalBanner />
    <script src="/js/reveal.js" defer></script>
  </body>
</html>




