---
type Props = {
  href: string;
  label: string;
  class?: string;
  target?: string;
  rel?: string;
  ariaLabel?: string;
  variant?: "default" | "soft";
  size?: "md" | "sm";
};

const {
  href,
  label,
  class: className = "",
  target = "_blank",
  rel = "noreferrer noopener",
  ariaLabel,
  variant = "default",
  size = "md",
} = Astro.props as Props;

const sizeClass =
  size === "sm"
    ? "px-6 py-2.5 text-xs md:text-sm"
    : "px-7 py-3 text-sm md:text-base";

const variantClass =
  variant === "soft"
    ? "bg-gradient-to-r from-[#24d366] to-[#1aae57] shadow-[0_10px_22px_rgba(26,174,87,0.32)] hover:to-[#20b45f]"
    : "bg-gradient-to-r from-[#22c35e] to-[#0fa756] shadow-[0_10px_22px_rgba(15,167,86,0.35)] hover:to-[#12b463]";

const iconSizeClass = size === "sm" ? "h-8 w-8" : "h-9 w-9";
const iconVariantClass =
  variant === "soft"
    ? "bg-white/12 group-hover:bg-white/18"
    : "bg-white/15 group-hover:bg-white/20";
---

<a
  href={href}
  target={target}
  rel={rel}
  aria-label={ariaLabel ?? undefined}
  class:list={[
    "group inline-flex items-center gap-3 rounded-full font-semibold text-white transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#f3eadb]",
    sizeClass,
    variantClass,
    className,
  ]}
>
  <span
    class:list={[
      "inline-flex items-center justify-center rounded-full text-white transition",
      iconSizeClass,
      iconVariantClass,
    ]}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 32 32"
      class="h-5 w-5"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M16 3.5c-6.884 0-12.5 5.49-12.5 12.241 0 2.224.595 4.388 1.727 6.283L3.5 28.5l6.68-1.742A12.86 12.86 0 0 0 16 27.241C22.884 27.241 28.5 21.751 28.5 15 28.5 8.49 22.884 3.5 16 3.5Zm0 21.182a10.34 10.34 0 0 1-5.317-1.47l-.381-.23-3.94 1.028 1.052-3.674-.248-.402a10.206 10.206 0 0 1-1.6-5.934C5.566 9.746 10.233 5.68 16 5.68c5.733 0 10.434 4.066 10.434 9.32 0 5.255-4.701 9.681-10.434 9.681Zm5.732-6.288c-.318-.16-1.874-.925-2.165-1.03-.29-.106-.501-.16-.713.16-.212.319-.818 1.03-1.002 1.24-.183.212-.367.239-.686.08-.318-.16-1.342-.488-2.556-1.557-.945-.832-1.58-1.86-1.764-2.18-.184-.319-.02-.49.14-.65.144-.143.318-.37.479-.554.158-.185.21-.318.318-.53.106-.212.053-.397-.026-.556-.08-.159-.713-1.71-.978-2.347-.257-.617-.517-.533-.713-.542a6.24 6.24 0 0 0-.61-.01c-.212 0-.556.08-.848.398-.29.319-1.114 1.088-1.114 2.654 0 1.565 1.141 3.078 1.301 3.29.159.212 2.242 3.458 5.426 4.695.758.309 1.348.493 1.811.631.761.24 1.45.206 1.997.125.609-.091 1.874-.766 2.14-1.504.264-.737.264-1.368.185-1.505-.079-.137-.29-.212-.609-.372Z" />
    </svg>
  </span>
  <span class="leading-tight text-left">
    {label}
  </span>
</a>
