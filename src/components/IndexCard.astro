---
const { data } = Astro.props;
const { image, title, text, button, name } = data;
---

<div
  class="group relative flex h-full flex-col overflow-hidden rounded-[2.5rem] border border-[#e6d7c6] bg-[#fbf7f1] p-9 shadow-[0_20px_45px_rgba(74,63,52,0.12)] transition duration-300 hover:-translate-y-1"
>
  <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-[#e8dcc8] ring-1 ring-[#d8c6b0] shadow-inner">
    <img src={image} alt={title} class="w-7 h-7 transition duration-300 group-hover:scale-110 opacity-90" />
  </div>
  <h3 class="mt-6 text-2xl font-title text-[#1b1916]">{title}</h3>
  <p class="mt-4 text-sm md:text-base text-[#4a433b] leading-relaxed">{text}</p>
  <div class="mt-auto pt-6 self-start">
    <a
      href={`#${name}`}
      class="inline-flex items-center rounded-full border border-[#c8ab88] px-5 py-2 text-xs md:text-sm font-semibold uppercase tracking-wide text-[#1b1916] transition hover:bg-[#c8ab88]"
    >
      {button}
    </a>
  </div>
</div>
