---
import ServiceCard from "./ServiceCard.astro";

interface ServiceItem {
  image: string;
  name: string;
  text: string;
  id?: string;
}

interface Props {
  services: ServiceItem[];
  categoryKey: string;
  blockId: string;
  chunkIndex: number;
  isFirstCategory?: boolean;
}

const { services, categoryKey, chunkIndex, isFirstCategory = false } = Astro.props as Props;
---

<div
  class="pt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
  data-reveal-group
  data-reveal-stagger="0.08"
  data-reveal-variant="card"
>
  {services.map((service, index) => {
    const cardId = service.id ?? `${categoryKey}-${service.name}`.toLowerCase().replace(/\s+/g, "-");
    const fetchPriority = isFirstCategory && chunkIndex === 0 && index === 0 ? "high" : "auto";
    const delay = Math.min(index * 0.07, 0.35).toFixed(2);

    return (
      <ServiceCard
        image={service.image}
        name={service.name}
        text={service.text}
        fetchPriority={fetchPriority}
        data-reveal
        data-reveal-delay={delay}
        data-service-id={cardId}
      />
    );
  })}
</div>
