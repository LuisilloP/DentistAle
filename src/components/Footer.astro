---
import { navLinks } from "../data/content";
---

<footer class="border-t border-white/10 bg-[#0f0e0c] text-zinc-300">
  <div class="w-full max-w-screen-xl mx-auto px-4 sm:px-5 py-10 sm:py-12">
    <div class="grid gap-8 md:grid-cols-[auto_1fr] md:gap-10">
      <a
        href="#principal"
        class="group inline-flex items-center gap-2.5 self-center md:self-start rounded-full px-1.5 py-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#c8ab88] focus-visible:ring-offset-2 focus-visible:ring-offset-[rgba(15,14,12,0.9)]"
        aria-label="Volver al inicio"
      >
        <span
          class="flex h-10 w-10 md:h-11 md:w-11 items-center justify-center overflow-hidden rounded-full border border-[rgba(255,255,255,0.16)] bg-white/90 shadow-[0_10px_24px_rgba(0,0,0,0.18)] transition duration-200 group-hover:shadow-[0_12px_26px_rgba(0,0,0,0.22)]"
        >
          <img
            src="/images/brand/icon.png"
            alt="Clínica Dental Mirador"
            loading="lazy"
            decoding="async"
            class="h-7 w-7 object-contain transition-transform duration-300 group-hover:scale-[1.02]"
          />
        </span>
        <span class="flex flex-col leading-tight">
          <span class="text-[11px] font-semibold uppercase tracking-[0.26em] text-[#f3eadb] md:text-[12px]">
            Clínica Dental
          </span>
          <span class="text-[11px] md:text-[12px] text-[#e7dac4]">Mirador</span>
        </span>
      </a>

      <div class="flex flex-col gap-5 md:items-end">
        <ul class="flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm font-medium text-zinc-400 md:justify-end">
          {navLinks.map((nav) => (
            <li key={nav.id}>
              <a class="transition hover:text-white" href={`#${nav.id}`}>
                {nav.label}
              </a>
            </li>
          ))}
        </ul>

        <div class="flex flex-col items-center gap-1 text-sm text-zinc-400 md:items-end">
          <span>Ovalle, Coquimbo</span>
          <a href="tel:+56927151566" class="transition hover:text-white">+56 9 2715 1566</a>
          <a href="mailto:a.bacic.v@gmail.com" class="transition hover:text-white break-all">a.bacic.v@gmail.com</a>
        </div>

        <div class="flex items-center justify-center gap-3 md:justify-end">
          <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-white/80">Síguenos</p>
          <a
            href="https://www.instagram.com/clinicadental.sb/"
            target="_blank"
            rel="noreferrer noopener"
            aria-label="Instagram"
          >
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/15 bg-white/10 transition hover:bg-white/15">
              <img src="/svg/IgLogo.svg" width="22" height="22" alt="Logo Instagram" class="h-6 w-6" />
            </span>
          </a>
          <a
            href="https://web.facebook.com/people/Clinica-Dental-SB/61553382780456/?is_tour_dismissed=true"
            target="_blank"
            rel="noreferrer noopener"
            aria-label="Facebook"
          >
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/15 bg-white/10 transition hover:bg-white/15">
              <img src="/svg/FLogo.svg" width="22" height="22" alt="Logo Facebook" class="h-6 w-6" />
            </span>
          </a>
        </div>
      </div>
    </div>

    <hr class="my-8 border-white/10" />
    <p class="text-center sm:text-left text-xs text-zinc-500">(c) Clínica Dental Mirador. Todos los derechos reservados.</p>
  </div>
</footer>