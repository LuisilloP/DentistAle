---
import ImageTextContact from "../components/ImageTextContact.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { contactContent } from "../data/content";
import { buildWhatsAppLink } from "../utils/whatsapp";

const contact = contactContent;
const title = contact.title;
const panel = contact.panel;
const image = contact.image;
const chips = Array.isArray(contact.chips) ? contact.chips : [];

const phone = panel.phone;
const panelMessage = panel.waText;
const panelLink = buildWhatsAppLink(phone, panelMessage);
---

<div
  class="max-w-6xl mx-auto px-4 py-16 grid lg:grid-cols-[0.95fr_1.05fr] gap-10 lg:items-center"
  data-reveal-group
  data-reveal-stagger="0.14"
>
  <div class="flex flex-col gap-6" data-reveal data-reveal-variant="section">
    <div>
      <p class="text-xs uppercase tracking-[0.4em] text-[#6e6254]">{contact.badge}</p>
      <h2 class="font-title text-3xl md:text-5xl text-[#1b1916]">
        {title.prefix}<span class="color-text-beige">{title.accent}</span>
      </h2>
      <p class="mt-4 text-[#3f3831] text-base md:text-lg leading-relaxed">{contact.description}</p>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <WhatsAppButton
        href={panelLink}
        label="Agenda tu evaluación por WhatsApp"
        variant="soft"
      />
      <span class="text-xs uppercase tracking-[0.25em] text-[#6e6254]">Respuesta rápida</span>
    </div>

    <div class="relative -mt-2 md:-mt-6">
      <ImageTextContact alt={image.alt} badge={image.badge} caption={image.caption} />
    </div>
  </div>

  <div
    class="rounded-[2.5rem] bg-[#141311] text-white p-6 md:p-10 shadow-[0_22px_60px_rgba(0,0,0,0.35)] border border-white/10"
    data-reveal
    data-reveal-delay="0.1"
    data-reveal-variant="card"
  >
    <div class="flex flex-col gap-6">
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-[#c8ab88]">{panel.badge}</p>
        <h3 class="mt-3 text-2xl md:text-3xl font-title">{panel.title}</h3>
        <p class="mt-3 text-white/70 text-sm md:text-base leading-relaxed">{panel.subtitle}</p>
      </div>

      <div class="flex flex-wrap gap-2">
        {chips.map((chip) => {
          const chipLabel = chip?.label ?? "";
          const chipMessage = chip?.waText ?? "";
          const chipLink = buildWhatsAppLink(phone, chipMessage);

          return (
            <a
              href={chipLink}
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center justify-center rounded-full border border-[#c8ab88]/25 bg-white/5 px-4 py-2 text-xs md:text-sm font-semibold text-[#f3eadb] transition hover:border-[#c8ab88]/60 hover:bg-[#c8ab88]/15"
            >
              {chipLabel}
            </a>
          );
        })}
      </div>

      <div class="rounded-[28px] bg-white/5 border border-[#c8ab88]/20 px-4 py-4 md:px-5 md:py-4 flex flex-col md:flex-row md:items-center gap-4">
        <div class="flex items-center gap-3 flex-1">
          <span class="flex h-12 w-12 items-center justify-center rounded-full bg-[#25D366]/15 border border-[#25D366]/30">
            <span class="h-3 w-3 rounded-full bg-[#25D366]"></span>
          </span>
          <div class="flex flex-col gap-1 flex-shrink-0">
            <p class="text-xs uppercase tracking-[0.22em] text-white/55">{panel.whatsappLabel}</p>
            <p class="text-xl md:text-2xl font-semibold text-white whitespace-nowrap">{phone}</p>
          </div>
        </div>
        <WhatsAppButton
          href={panelLink}
          label={panel.ctaLabel}
          variant="soft"
          size="sm"
          class="w-full md:w-auto justify-center"
        />
      </div>

      <p class="text-xs text-white/60">{panel.microcopy}</p>
    </div>
  </div>
</div>
