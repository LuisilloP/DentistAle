---
import { generalInfoContent } from "../data/content";
---

<div class="max-w-7xl mx-auto px-4 py-16" data-reveal-group data-reveal-stagger="0.1">
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4" data-reveal-group data-reveal-stagger="0.08">
    {generalInfoContent.cards.map((card) => (
      <div class="rounded-3xl border border-[#e3d6c6] bg-white/85 p-5 shadow-xl" data-reveal>
        <p class="text-xs uppercase tracking-[0.3em] text-[#6e6254]">{card.badge}</p>
        <p class="mt-2 text-lg font-semibold text-[#1b1916]">{card.title}</p>
        {card.text && <p class="mt-2 text-sm text-[#4a433b]">{card.text}</p>}
        {card.lines && (
          <div class="mt-2 inline-flex flex-col gap-1 text-sm text-[#4a433b]">
            {card.lines.map((line) => (
              <span>{line}</span>
            ))}
          </div>
        )}
        {card.contacts && (
          <div class="mt-2 flex flex-col gap-2 text-sm text-[#4a433b]">
            {card.contacts.map((contact) => (
              <a href={contact.href} class="hover:text-[#1b1916]">{contact.label}</a>
            ))}
          </div>
        )}
        {card.cta && (
          <a
            target="_blank"
            rel="noreferrer noopener"
            href={card.cta.href}
            class="mt-4 inline-flex items-center text-sm font-semibold text-[#1b1916]"
          >
            {card.cta.label}
          </a>
        )}
      </div>
    ))}
  </div>
</div>
