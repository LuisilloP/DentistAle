---
import SubTitle from "../components/SubTitle.astro";
import { paymentContent } from "../data/content";
---

<div class="max-w-6xl mx-auto px-4 py-16" data-reveal-group data-reveal-stagger="0.12">
  <p class="text-xs uppercase tracking-[0.4em] text-[#c8ab88]" data-reveal data-reveal-variant="text">{paymentContent.badge}</p>
  <SubTitle classAlter="text-white" text={paymentContent.title} data-reveal data-reveal-variant="section" />
  <p class="mt-4 text-white/70 text-base md:text-lg max-w-2xl leading-relaxed" data-reveal data-reveal-variant="text">
    {paymentContent.description}
  </p>

  <div class="mt-8 grid gap-6 md:grid-cols-2" data-reveal-group data-reveal-stagger="0.1" data-reveal-variant="card">
    {paymentContent.cards.map((card) => (
      <div class="rounded-[26px] border border-[#e3d6c6]/70 bg-white/95 p-6 shadow-[0_20px_50px_rgba(0,0,0,0.35)]" data-reveal>
        <div class="mb-3 inline-flex items-center rounded-full bg-[#e8dcc8]/50 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.2em] text-[#5a4b3a]">
          {card.badge}
        </div>
        <div class="relative flex aspect-[20/9] items-center justify-center overflow-hidden rounded-2xl bg-white">
          <img
            src={card.image}
            width="1200"
            height="600"
            alt={card.alt}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-contain transition-transform duration-300"
          />
          <div class="pointer-events-none absolute inset-0 rounded-2xl bg-gradient-to-t from-black/6 via-transparent to-transparent"></div>
        </div>
      </div>
    ))}
  </div>
</div>
