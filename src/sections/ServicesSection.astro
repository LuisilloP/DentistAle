---
import SubTitle from "../components/SubTitle.astro";
import ServiceBlock from "../components/ServiceBlock.astro";
import ServiceCard from "../components/ServiceCard.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { buildWhatsAppLink } from "../utils/whatsapp";
import {
  servicesContent,
  servicesImplantology,
  servicesGeneral,
  servicesBucalEndo,
  servicesEsthetic,
  servicesRehabilitation,
  servicesFacial,
  contactContent,
} from "../data/content";

const serviceMap: Record<string, any[]> = {
  servicesImplantology,
  servicesGeneral,
  servicesBucalEndo,
  servicesEsthetic,
  servicesRehabilitation,
  servicesFacial,
};

const getServices = (key: string) => serviceMap[key] ?? [];
const firstCategoryKey = servicesContent.categories[0]?.itemsKey ?? "";
const CHUNK_SIZE = 6; // Ajusta este valor para cargar más o menos cards por bloque.

const chunkServices = (items: any[], size: number) =>
  items.reduce<any[][]>((acc, item, index) => {
    const groupIndex = Math.floor(index / size);
    if (!acc[groupIndex]) acc[groupIndex] = [];
    acc[groupIndex].push(item);
    return acc;
  }, []);

const normalize = (value: string) =>
  value.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "").trim();

const featuredOrder = [
  "Emergencia dental",
  "Tratamiento de conducto",
  "Implante simple",
  "Coronas",
  "Limpieza",
  "Pulido radicular",
];

const allServices = Object.values(serviceMap).flat();
const featuredServices = featuredOrder
  .map(
    (name) =>
      allServices.find(
        (service) => normalize(service.name) === normalize(name),
      ) ||
      allServices.find((service) =>
        normalize(service.name).includes(normalize(name)),
      ),
  )
  .filter(Boolean);

const featuredNames = new Set(
  featuredServices.map((service) => normalize(service.name)),
);

const mergedKeys = ["servicesBucalEndo", "servicesEsthetic", "servicesRehabilitation"];
const mergedServices = mergedKeys
  .map((key) => getServices(key))
  .flat()
  .filter((service) => !featuredNames.has(normalize(service.name)));

const filteredCategories = servicesContent.categories
  .map((category) => {
    if (mergedKeys.includes(category.itemsKey)) {
      return null;
    }
    const services = getServices(category.itemsKey).filter(
      (service) => !featuredNames.has(normalize(service.name)),
    );
    return { ...category, services };
  })
  .filter((category) => category && category.services.length > 0);

const servicesCtaLink = buildWhatsAppLink(
  contactContent.panel.phone,
  "Hola, quiero agendar una evaluación.",
);
---

<div class="flex flex-col gap-12" data-reveal-group data-reveal-stagger="0.1">
  <div class="max-w-3xl" data-reveal>
    <p class="text-xs uppercase tracking-[0.4em] text-[#c8ab88]">
      {servicesContent.badge}
    </p>
    <SubTitle classAlter="text-white" text={servicesContent.title} />
    <p class="mt-4 text-white/70 text-base md:text-lg leading-relaxed">
      {servicesContent.description}
    </p>
  </div>

  <div
    class="grid gap-4 md:grid-cols-3"
    data-reveal-group
    data-reveal-stagger="0.08"
  >
    {
      servicesContent.steps.map((step) => (
        <div
          class="rounded-2xl border border-white/10 bg-[#151311] p-6 text-white/80 shadow-xl"
          data-reveal
        >
          <p class="text-xs uppercase tracking-[0.3em] text-white/60">
            {step.label}
          </p>
          <p class="mt-2 text-lg font-semibold">{step.title}</p>
          <p class="mt-2 text-sm text-white/70">{step.text}</p>
        </div>
      ))
    }
  </div>

  <section class="flex flex-col gap-6" data-reveal>
    <SubTitle
      classAlter="text-white text-3xl md:text-4xl"
      text="Servicios destacados"
    />
    <div
      class="pt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
      data-reveal-group
      data-reveal-stagger="0.08"
    >
      {
        featuredServices.map((service, index) => (
          <ServiceCard
            image={service.image}
            name={service.name}
            text={service.text}
            fetchPriority={index === 0 ? "high" : "auto"}
            data-reveal
          />
        ))
      }
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <WhatsAppButton href={servicesCtaLink} label="Agenda tu evaluación por WhatsApp" />
      <span class="text-xs uppercase tracking-[0.25em] text-white/60"
        >Respuesta rápida</span
      >
    </div>
  </section>

  {filteredCategories.length > 0 && (
    <details
      class="rounded-[2rem] border border-white/10 bg-[#151311] p-6 md:p-8 text-white/80 shadow-xl"
      data-reveal
    >
      <summary class="cursor-pointer text-sm md:text-base font-semibold uppercase tracking-[0.3em] text-[#f3eadb] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#c8ab88]">
        Ver más servicios
      </summary>
      <div class="mt-6 flex flex-col gap-12" data-reveal-group data-reveal-stagger="0.12">
        {mergedServices.length > 0 && (
          <section class="flex flex-col gap-6" data-reveal>
            <SubTitle classAlter="text-white text-2xl md:text-3xl" text="Rehabilitación y estética periodontal" />
            <div class="flex flex-col gap-10">
              <ServiceBlock
                services={mergedServices}
                categoryKey="merged-bucal"
                blockId="merged-bucal-0"
                chunkIndex={0}
                isFirstCategory={false}
              />
            </div>
          </section>
        )}

        {filteredCategories.map((category) => {
          const chunks = chunkServices(category.services, CHUNK_SIZE);

          return (
            <section class="flex flex-col gap-6" data-reveal>
              <SubTitle classAlter="text-white text-2xl md:text-3xl" text={category.title} />
              <div class="flex flex-col gap-10">
                {chunks.map((chunk, chunkIndex) => (
                  <ServiceBlock
                    services={chunk}
                    categoryKey={category.itemsKey}
                    blockId={`${category.itemsKey}-${chunkIndex}`}
                    chunkIndex={chunkIndex}
                    isFirstCategory={category.itemsKey === firstCategoryKey}
                  />
                ))}
              </div>
            </section>
          );
        })}
      </div>
    </details>
  )}
</div>
