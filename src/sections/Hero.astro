---
import ButtonContactShadow from "../components/ButtonContactShadow.astro";
import { heroContent, contactContent } from "../data/content";
import { buildWhatsAppLink } from "../utils/whatsapp";

const hero = heroContent;
const contact = contactContent;
const heroPhone = contact?.panel?.phone ?? "";
const heroWaLink = buildWhatsAppLink(heroPhone, hero?.ctaPrimary?.waText ?? "");
const heroTelLink = heroPhone ? `tel:+${heroPhone.replace(/\D/g, "")}` : "tel:+56927151566";
---

<div class="relative overflow-hidden">
  <div class="pointer-events-none absolute -top-24 -right-24 h-[22rem] w-[22rem] rounded-full bg-[#EA0892]/18 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-24 -left-24 h-[26rem] w-[26rem] rounded-full bg-[#FECD53]/18 blur-3xl"></div>

  <div
    class="max-w-7xl mx-auto px-4 pt-36 pb-24 grid gap-12 lg:grid-cols-[1.1fr_0.9fr] items-center"
    data-reveal-group
    data-reveal-stagger="0.1"
  >
    <div class="flex flex-col gap-6" data-reveal>
      <div class="flex items-center gap-4 text-xs uppercase tracking-[0.4em] text-white/70">
        <span class="h-[3px] w-10 rounded-full bg-[linear-gradient(90deg,#EA0892,#FECD53)]"></span>
        {hero.badge}
      </div>
      <h1 class="font-title text-4xl md:text-6xl text-white leading-tight">
        {hero.title.prefix}<span class="color-text-beige">{hero.title.accent}</span>{hero.title.suffix}
      </h1>
      <p class="text-white/80 text-base md:text-lg leading-relaxed max-w-xl">
        {hero.description[0]}
        <br /><br />
        {hero.description[1]}
      </p>
      <div class="flex flex-col gap-4 items-start">
        <div class="flex flex-col sm:flex-row gap-4 items-start">
          <ButtonContactShadow
            href={heroWaLink}
            label={hero.ctaPrimary?.label ?? "Agendar por WhatsApp"}
            target="_blank"
            rel="noreferrer noopener"
          />
          <a
            href={heroTelLink}
            class="inline-flex items-center justify-center rounded-full border border-white/40 px-6 py-3 text-sm md:text-base font-semibold text-white/90 transition hover:border-white hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white/70"
          >
            {hero.ctaCallLabel ?? "Llamar"}
          </a>
        </div>
        <p class="text-xs uppercase tracking-[0.3em] text-white/60">{hero.ctaPrimary?.helper ?? ""}</p>
        <a
          href="#services"
          class="text-white/80 hover:text-white underline underline-offset-8 decoration-white/40 text-sm md:text-base"
        >
          {hero.ctaSecondary}
        </a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 text-xs uppercase tracking-[0.2em] text-white/70">
        {hero.bullets.map((item) => (
          <span class="rounded-full border border-white/10 px-4 py-2 text-center">{item}</span>
        ))}
      </div>
    </div>

    <div class="relative group" data-reveal>
      <div class="relative h-[22rem] md:h-[30rem] lg:h-[34rem] rounded-[2.5rem] overflow-hidden shadow-2xl">
        <div class="absolute inset-x-0 top-0 h-1/2 overflow-hidden transition-transform duration-700 group-hover:translate-y-3 fade-down bg-[#0f0e0c]">
          <img
            src="/images/hero/thooths.png"
            alt="Detalle de sonrisa saludable"
            class="h-full w-full object-contain object-center"
            loading="eager"
          />
        </div>
        <div class="absolute inset-x-0 bottom-0 h-1/2 overflow-hidden transition-transform duration-700 group-hover:-translate-y-3 fade-up bg-[#0f0e0c]">
          <img
            src="/images/hero/inferior.png"
            alt="Implantes dentales en clinica"
            class="h-full w-full object-contain object-center"
            loading="eager"
          />
        </div>
      </div>
      <div class="absolute -bottom-6 left-6 bg-[#0f0e0c]/80 border border-white/10 text-white rounded-2xl px-4 py-3 shadow-xl">
        <p class="text-[11px] uppercase tracking-[0.3em] text-white/60">{hero.ribbon.badge}</p>
        <p class="text-base font-semibold">{hero.ribbon.title}</p>
      </div>
    </div>
  </div>
</div>
