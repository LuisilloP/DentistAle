---
import SubTitle from "../components/SubTitle.astro";
import { aboutContent } from "../data/content";

const about = aboutContent;
---

<div
  class="max-w-7xl mx-auto px-4 py-16 grid lg:grid-cols-[0.9fr_1.1fr] gap-12 items-center"
  data-reveal-group
  data-reveal-stagger="0.12"
>
  <div class="relative" data-reveal data-reveal-variant="image">
    <div class="absolute -top-4 -left-4 h-full w-full rounded-[2.5rem] border border-[#c8ab88]/40"></div>
    <img
      src="/images/people/dentistPrincipal.webp"
      class="relative h-[24rem] sm:h-[28rem] md:h-[34rem] w-full object-cover object-[50%_40%] sm:object-[50%_45%] md:object-[50%_50%] rounded-[2.5rem] shadow-2xl"
      alt="Dr. Alejandro Bacic en la clínica"
      width="680"
      height="1020"
      loading="lazy"
      decoding="async"
    />
    <div
      class="absolute -bottom-6 right-6 bg-white/90 border border-[#e3d6c6] rounded-2xl px-4 py-3 shadow-xl"
    >
      <p class="text-xs uppercase tracking-[0.3em] text-[#6e6254]">{about.specialtyCard.badge}</p>
      <p class="text-sm font-semibold text-[#1b1916]">{about.specialtyCard.title}</p>
    </div>
  </div>

  <div class="flex flex-col gap-6" data-reveal data-reveal-variant="section">
    <div>
      <p class="text-xs uppercase tracking-[0.4em] text-[#6e6254]">{about.badge}</p>
      <SubTitle text={about.name} />
    </div>

    <div class="flex flex-wrap gap-x-6 gap-y-2 text-xs uppercase tracking-[0.18em] text-[#6e6254]">
      {about.chips.map((chip) => (
        <span class="inline-flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-[#c8ab88]"></span>
          {chip}
        </span>
      ))}
    </div>

    {about.trustBullets?.length > 0 && (
      <ul class="grid gap-2 text-sm text-[#4a433b] sm:grid-cols-2">
        {about.trustBullets.map((item) => (
          <li class="inline-flex items-start gap-3">
            <span class="mt-2 h-2 w-2 rounded-full bg-[#c8ab88]"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    )}

    <div class="flex flex-col gap-4 text-[#3f3831] text-base md:text-lg leading-relaxed">
      {about.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </div>
</div>
