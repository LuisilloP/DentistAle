---
import { cellphoneContent } from "../data/content";
---

<div class="py-12">
  <div class="max-w-6xl mx-auto px-4" data-reveal>
    <div class="rounded-3xl bg-[#0f0e0c] text-white px-6 py-8 shadow-2xl flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div class="text-base md:text-lg leading-relaxed">
        {cellphoneContent.text}
      </div>
      <a
        href="#contact"
        class="inline-flex items-center justify-center rounded-full border border-white/30 px-5 py-2 text-xs uppercase tracking-[0.3em] text-white hover:bg-white/10"
      >
        {cellphoneContent.ctaLabel}
      </a>
    </div>
  </div>
</div>
