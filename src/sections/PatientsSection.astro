---
import SubTitle from "../components/SubTitle.astro";
import { patients, patientsContent, contactContent } from "../data/content";
import { buildWhatsAppLink } from "../utils/whatsapp";

const patientsCtaLink = buildWhatsAppLink(
  contactContent.panel.phone,
  "Hola, quiero agendar una evaluacion."
);
---

<div class="max-w-6xl mx-auto px-4 py-16" data-reveal-group data-reveal-stagger="0.12">
  <p class="text-xs uppercase tracking-[0.4em] text-[#c8ab88]" data-reveal>
    {patientsContent.badge}
  </p>
  <SubTitle classAlter="text-white" text={patientsContent.title} data-reveal />
  <p class="mt-4 text-white/70 text-base md:text-lg max-w-2xl leading-relaxed" data-reveal>
    {patientsContent.description}
  </p>

  <div class="mt-8 grid gap-8 lg:grid-cols-2" data-reveal-group data-reveal-stagger="0.1">
    {patients.map((patient) => (
      <div class="rounded-3xl border border-white/10 bg-white/5 p-6 shadow-2xl" data-reveal>
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div>
            <p class="text-xs uppercase tracking-[0.3em] text-white/60">{patientsContent.caseLabel}</p>
            <h3 class="text-2xl md:text-3xl font-title text-white capitalize">{patient.name}</h3>
            <p class="text-white/70">{patient.procedure}</p>
          </div>
          <span class="rounded-full border border-white/20 px-4 py-2 text-xs uppercase tracking-[0.2em] text-white/70">
            {patientsContent.slideHint}
          </span>
        </div>
        <div class="mt-6 relative w-full h-[18rem] sm:h-[20rem] lg:h-[22rem] overflow-hidden rounded-2xl border border-white/10">
          <swiper-container
            slides-per-view="1"
            space-between="16"
            loop="true"
            pagination="true"
            pagination-clickable="true"
            class="patient-gallery-swiper absolute inset-0 h-full w-full"
            aria-label={`Galeria de ${patient.name}`}
          >
            {patient.images.map((image, index) => (
              <swiper-slide class="block h-full w-full">
                <div class="relative h-full w-full">
                  <img
                    src={image}
                    width="1200"
                    height="800"
                    alt={`Caso clinico de ${patient.name} ${index + 1}`}
                    loading="eager"
                    decoding="async"
                    class="block h-full w-full object-cover"
                  />
                  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/15 via-transparent to-transparent" />
                </div>
              </swiper-slide>
            ))}
          </swiper-container>
        </div>
      </div>
    ))}
  </div>

  <div class="mt-8 flex flex-col gap-4 text-sm text-white/70" data-reveal>
    <a
      href={patientsCtaLink}
      target="_blank"
      rel="noreferrer noopener"
      class="inline-flex w-fit items-center justify-center rounded-full bg-[#25D366] px-5 py-3 text-xs md:text-sm font-semibold uppercase tracking-[0.2em] text-[#0b0f0c] transition hover:bg-[#38e377] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#f3eadb]"
    >
      Agenda tu evaluacion por WhatsApp
    </a>
  </div>
</div>
